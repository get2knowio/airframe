# airframe provider credentials — copy to `.env` and fill in whatever you have.
# The smoke test (examples/smoke_providers.py) loads this WITHOUT overriding any
# real env you already have set (real env wins unless you pass --override-env).
# You only need keys for the providers you want to exercise; the rest are skipped
# with a reason printed.

# --- Claude (provider id: claude) ------------------------------------------
# Prefer the OAuth token (Claude subscription) or use an Anthropic API key.
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# --- GitHub Copilot (provider id: github-copilot) --------------------------
# A GitHub token with Copilot access. GH_TOKEN is also accepted.
GITHUB_TOKEN=
# GH_TOKEN=

# --- OpenRouter (provider id: openrouter) ----------------------------------
OPENROUTER_API_KEY=
# OPENROUTER_DEFAULT_MODEL=
# OPENROUTER_BASE_URL=

# --- OpenCode Zen / Go (provider ids: opencode-zen, opencode-go) -----------
# Both OpenAI-compatible families share this key.
OPENCODE_API_KEY=
# OPENCODE_ZEN_DEFAULT_MODEL=
# OPENCODE_GO_DEFAULT_MODEL=

# --- OpenCode server (provider id: opencode) -------------------------------
# Requires a RUNNING OpenCode HTTP agent server reachable at this URL.
OPENCODE_SERVER_URL=
# OPENCODE_SERVER_USERNAME=
# OPENCODE_SERVER_PASSWORD=
# OPENCODE_SERVER_DEFAULT_MODEL=

# --- AWS Bedrock (provider id: bedrock) ------------------------------------
# Standard AWS auth chain. Set a region + either static keys or a profile.
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=
# BEDROCK_DEFAULT_MODEL=

# --- Optional: per-provider model override for the smoke test --------------
# Some providers have no default model; set the model the probe should use.
# AIRFRAME_PROBE_MODEL_CLAUDE=claude-haiku-4-5
# AIRFRAME_PROBE_MODEL_GITHUB_COPILOT=gpt-4o
# AIRFRAME_PROBE_MODEL_OPENROUTER=openai/gpt-4o-mini
